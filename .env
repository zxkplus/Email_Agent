# ============================================
# LLM 模型配置
# ============================================

# 指定使用哪个模型提供商：openai / deepseek / azure / zhipu / qwen / moonshot / ollama
LLM_PROVIDER=deepseek

# ============================================
# DeepSeek 配置（默认使用）
# ============================================
DEEPSEEK_API_KEY=你的DeepSeek_API_KEY
# DEEPSEEK_MODEL=deepseek-chat  # 可选，不填用默认

# ============================================
# OpenAI 配置
# ============================================
# OPENAI_API_KEY=你的OpenAI_API_KEY
# OPENAI_MODEL=gpt-3.5-turbo

# ============================================
# 智谱AI (GLM-4) 配置
# ============================================
# ZHIPU_API_KEY=你的智谱API_KEY
# ZHIPU_MODEL=glm-4

# ============================================
# 通义千问配置
# ============================================
# DASHSCOPE_API_KEY=你的DashScope_API_KEY
# QWEN_MODEL=qwen-plus

# ============================================
# 月之暗面 (Moonshot) 配置
# ============================================
# MOONSHOT_API_KEY=你的Moonshot_API_KEY
# MOONSHOT_MODEL=moonshot-v1-8k

# ============================================
# 本地 Ollama 配置
# ============================================
# OLLAMA_API_KEY=ollama  # 随便填
# OLLAMA_MODEL=qwen:7b